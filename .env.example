# 필요할 때 이 파일을 .env로 복사해 포트를 변경하세요.
# 웹 관리 화면과 MCP HTTP 서버는 서로 다른 포트를 사용합니다.
WEB_PORT=3200
MCP_PORT=3201
WEB_BIND_IP=0.0.0.0
MCP_BIND_IP=0.0.0.0

# Docker에서 웹 관리 화면을 서버 IP로 접속하도록 허용합니다.
# 인증 기능은 없으므로 방화벽에서 접속 가능한 IP를 제한하세요.
PUBLIC_WEB_ACCESS=true

# Docker에서 MCP HTTP도 서버 IP로 접속하도록 허용합니다.
# 인증이 없으므로 신뢰하는 클라이언트 IP만 방화벽에서 허용하세요.
PUBLIC_MCP_ACCESS=true
