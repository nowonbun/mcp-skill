{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "noEmitOnError": true
  },
  "include": ["server.ts", "lib/**/*.ts"],
  "exclude": ["dist", "node_modules", "test"]
}
